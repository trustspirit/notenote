# Non-secret function config (committed). The Anthropic key is a secret: firebase functions:secrets:set ANTHROPIC_API_KEY
# Comma-separated emails allowed to use AI organize. Empty = every signed-in user.
AI_ALLOWED_EMAILS=
# AI units per user per UTC day. Each "정리하기" (organize + web check) uses 5, so 30 = 6 per day.
AI_DAILY_LIMIT=30
