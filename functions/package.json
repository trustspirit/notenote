{
  "name": "smart-notes-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-smart-notes --only auth,firestore,functions 'node e2e/emulator.e2e.mjs'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
