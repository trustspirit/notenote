# Copy to .env.local (gitignored) and fill from Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# true = use local emulators (auth/firestore/functions)
VITE_USE_EMULATOR=false

# Optional: Google Drive backup. OAuth 2.0 Web client ID from Google Cloud console
# (APIs & Services > Credentials). Firebase creates one for Google sign-in already.
VITE_GOOGLE_CLIENT_ID=
