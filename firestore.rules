rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Public mirrors are keyed "{ownerUid}_{privateId}". The owner is part of the id,
    // so nobody else can ever (re)create a document behind someone's link, even after
    // it was unshared — and checking it needs no exists()/get() calls, which keeps
    // large batched shares under Firestore's 20-access-calls-per-request limit.
    function ownsShareId(shareId) {
      return signedIn() && shareId.matches(request.auth.uid + '_[^_]+');
    }

    function isAuthor(d) {
      return d.ownerUid == request.auth.uid
        && d.authorName == request.auth.token.get('name', '익명');
    }

    function validNoteMirror(d) {
      return isAuthor(d)
        && d.keys().hasOnly(['id', 'ownerUid', 'authorName', 'title', 'contentHtml', 'tags', 'updatedAt', 'kind', 'mindmap'])
        && d.title is string && d.title.size() <= 500
        && d.contentHtml is string && d.contentHtml.size() <= 900000
        && d.tags is list && d.tags.size() <= 50
        && d.updatedAt is int
        && (!('mindmap' in d) || (d.mindmap is list && d.mindmap.size() <= 2000));
    }

    function validNotebookMirror(d) {
      return isAuthor(d)
        && d.keys().hasOnly(['id', 'ownerUid', 'authorName', 'name', 'updatedAt'])
        && d.name is string && d.name.size() <= 200
        && d.updatedAt is int;
    }

    // Private workspace: users/{uid}/notebooks, users/{uid}/notes
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Read-only public mirror of an individually shared note.
    // get only (no list) so public notes can't be enumerated — you need the link.
    match /publicNotes/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if ownsShareId(shareId) && validNoteMirror(request.resource.data);
      allow delete: if ownsShareId(shareId);
    }

    // Read-only public mirror of a shared notebook ("project") and its notes.
    match /publicNotebooks/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if ownsShareId(shareId) && validNotebookMirror(request.resource.data);
      allow delete: if ownsShareId(shareId);

      // Listing is allowed only inside one notebook (you need the notebook link).
      // Deletable by the owner even after the notebook doc is gone (no orphans).
      match /notes/{noteId} {
        allow read: if true;
        allow create, update: if ownsShareId(shareId) && validNoteMirror(request.resource.data);
        allow delete: if ownsShareId(shareId);
      }
    }
  }
}
