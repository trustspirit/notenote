rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Private workspace: users/{uid}/notebooks, users/{uid}/notes
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Read-only public mirror, written only by Cloud Functions (functions/src/mirrorTriggers.ts)
    // from the private docs. Ids are "{ownerUid}_{id}". Clients can never write here, so
    // there is nothing to spoof, take over or leave behind.
    //
    // get only (no list): you need the link to read anything.
    match /publicNotes/{shareId} {
      allow get: if true;
      allow list, write: if false;
    }

    // A shared notebook ("project"): its doc carries the note list (title, excerpt, date),
    // each note is fetched on its own when opened.
    match /publicNotebooks/{shareId} {
      allow get: if true;
      allow list, write: if false;

      match /notes/{noteId} {
        allow get: if true;
        allow list, write: if false;
      }
    }

    // usage/{uid} (AI quota) and anything else: server only.
  }
}
